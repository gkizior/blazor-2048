@* The board's empty cells. They only change with the board size, so this component skips every
   other render of GameBoard (ShouldRender is false unless Count changed). *@
@for (var i = 0; i < Count; i++)
{
    <div class="cell"></div>
}

@code {
    [Parameter] public int Count { get; set; } = 16;

    private int renderedCount = -1;

    protected override bool ShouldRender() => Count != renderedCount;

    protected override void OnAfterRender(bool firstRender) => renderedCount = Count;
}
