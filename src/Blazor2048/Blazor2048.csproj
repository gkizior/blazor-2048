<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>

    <Version>1.1.0</Version>
    <Authors>Garrett Kizior</Authors>
    <RepositoryUrl>https://github.com/gkizior/blazor-2048</RepositoryUrl>
    <!-- The commit is shown separately in the footer, so keep the version clean (no "+sha"). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepoRoot>
    <DocsOutputDir>$(MSBuildProjectDirectory)/wwwroot/docs-content/</DocsOutputDir>
    <!-- DocsBuilder is referenced only for build ordering (ReferenceOutputAssembly=false), never shipped. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <DocsBuilderDll>$(RepoRoot)tools/DocsBuilder/bin/$(Configuration)/net10.0/DocsBuilder.dll</DocsBuilderDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game2048.Core\Game2048.Core.csproj" />
    <!-- Build-time tool only: makes sure DocsBuilder is built first; nothing is referenced or shipped. -->
    <ProjectReference Include="..\..\tools\DocsBuilder\DocsBuilder.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- ===== Docs: repo Markdown -> wwwroot/docs-content (HTML + index.json + diagram SVGs) ===== -->
  <ItemGroup>
    <DocsInput Include="$(RepoRoot)**/*.md;$(RepoRoot)docs/toc.yml;$(RepoRoot)docs/diagrams/*.svg;$(RepoRoot)docs/images/**"
               Exclude="$(RepoRoot)**/bin/**;$(RepoRoot)**/obj/**;$(RepoRoot)**/node_modules/**;$(RepoRoot).git/**;$(RepoRoot)artifacts/**;$(RepoRoot)publish/**;$(RepoRoot)**/TestResults/**" />
  </ItemGroup>

  <Target Name="BuildDocs"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="ResolveProjectReferences"
          Inputs="@(DocsInput);$(DocsBuilderDll)"
          Outputs="$(DocsOutputDir)index.json"
          Condition="'$(NoBuild)' != 'true'">
    <PropertyGroup>
      <_DotNetHost>$(DOTNET_HOST_PATH)</_DotNetHost>
      <_DotNetHost Condition="'$(_DotNetHost)' == ''">dotnet</_DotNetHost>
    </PropertyGroup>
    <Exec Command="&quot;$(_DotNetHost)&quot; &quot;$(DocsBuilderDll)&quot; build --repo &quot;$(RepoRoot.TrimEnd('/\'))&quot; --out &quot;$(DocsOutputDir.TrimEnd('/\'))&quot; --repo-url &quot;$(RepositoryUrl)&quot;" />
  </Target>

  <!-- Files generated during the build weren't there when wwwroot was globbed: (re)add them. -->
  <Target Name="IncludeDocsContent" AfterTargets="BuildDocs" BeforeTargets="ResolveProjectStaticWebAssets">
    <ItemGroup>
      <Content Remove="wwwroot\docs-content\**" />
      <Content Include="wwwroot\docs-content\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- ===== Build info for the footer: [AssemblyMetadata("BuildCommit"/"BuildDate"/"RepositoryUrl")] ===== -->
  <Target Name="AddBuildInfo" BeforeTargets="GetAssemblyAttributes;CoreGenerateAssemblyInfo">
    <Exec Command="git rev-parse HEAD" Condition="'$(GITHUB_SHA)' == ''" WorkingDirectory="$(RepoRoot)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low"
          EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup>
      <BuildCommit Condition="'$(BuildCommit)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</BuildCommit>
      <BuildCommit Condition="'$(BuildCommit)' == '' and '$(_GitExitCode)' == '0'">$(_GitCommit.Trim())</BuildCommit>
      <BuildCommit Condition="'$(BuildCommit)' == ''">unknown</BuildCommit>
      <!-- CI: exact UTC time. Locally: the UTC date, so repeated builds stay incremental. -->
      <BuildDate Condition="'$(BuildDate)' == '' and '$(GITHUB_ACTIONS)' == 'true'">$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BuildDate>
      <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd"))</BuildDate>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildCommit</_Parameter1>
        <_Parameter2>$(BuildCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildDate</_Parameter1>
        <_Parameter2>$(BuildDate)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RepositoryUrl</_Parameter1>
        <_Parameter2>$(RepositoryUrl)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
